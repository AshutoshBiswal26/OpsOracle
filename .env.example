# OpsOracle configuration (copy to .env; never commit .env)
# All values are optional; AWS credentials come from the standard Boto3/IAM chain.

# AWS region for collectors and Bedrock. If unset, the Boto3 default chain is used.
OPSORACLE_AWS_REGION=us-east-1

# AWS named profile (optional). Prefer IAM roles / default credential chain.
# AWS_PROFILE=default

# Amazon Bedrock model id used for reasoning.
OPSORACLE_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Max number of evidence events placed in the AI context (cost/context budget).
OPSORACLE_MAX_EVENTS=50

# Max output tokens requested from Bedrock.
OPSORACLE_MAX_TOKENS=1500

# Whether the Bedrock reasoning stage is enabled (true/false).
OPSORACLE_REASONING_ENABLED=true

# Bounded retry limit for AWS collectors on throttling/transient errors.
OPSORACLE_MAX_RETRIES=5
